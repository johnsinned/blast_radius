# Development-only filesystem profiling; first build Dockerfile.maps' environment.
FROM nicolaka/netshoot@sha256:7f08c4aff13ff61a35d30e30c5c1ea8396eac6ab4ce19fd02d5a4b3b5d0d09a2 AS tracing
FROM blast-radius-map-environment
COPY --from=tracing /usr/bin/strace /opt/trace/strace
COPY --from=tracing /lib/ld-musl-x86_64.so.1 /opt/trace/lib/
COPY --from=tracing /usr/lib/libdw* /usr/lib/libelf* /usr/lib/libz.so* /usr/lib/libfts* /usr/lib/libzstd* /usr/lib/liblzma* /usr/lib/libbz2* /opt/trace/lib/
