# Optional reproducible map regeneration in the scorer's Linux/Python image.
FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90 AS collect
WORKDIR /app
COPY requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r requirements.lock coverage==7.13.4
COPY tools /app/tools
RUN python tools/fetch_source.py /opt/sqlglot
# fetch_source uses a source archive, so create no git dependency: verify
# provenance against the pinned archive through the explicit archive mode.
RUN python tools/collect_map.py /opt/sqlglot --archive --output /app/raw.json
RUN python tools/compile_map.py /opt/sqlglot /app/raw.json --archive --output /export/dependencies.json

FROM scratch AS export
COPY --from=collect /export/ /
